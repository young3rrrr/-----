flowchart LR
    %% Актори системи
    subgraph Actors [" "]
        direction TB
        Admin["👤 <b>Адміністратор</b><br><i>(Admin)</i>"]
        SalesManager["👤 <b>Менеджер з продажу</b><br><i>(SalesManager)</i>"]
    end

    %% Межі системи OpenCRM
    subgraph OpenCRM ["<b>Система OpenCRM</b>"]
        direction TB
        UC03(["<b>UC-03: Керувати каталогом товарів</b><br><i>(Manage Catalog)</i>"])
        UC02(["<b>UC-02: Конвертувати ліда в клієнта</b><br><i>(Convert Lead)</i>"])
        UC04(["<b>UC-04: Призначити активність</b><br><i>(Schedule Activity)</i>"])
        UC01(["<b>UC-01: Вести комерційну угоду</b><br><i>(Manage Deal)</i>"])
        UC05(["<b>UC-05: Сформувати товарні позиції</b><br><i>(Add Deal Items)</i>"])
        UC06(["<b>UC-06: Застосувати персональну знижку</b><br><i>(Apply Discount)</i>"])
    end

    %% Узагальнення (наслідування) акторів
    Admin -->|«generalization»| SalesManager

    %% Асоціації акторів з прецедентами
    Admin --- UC03
    SalesManager --- UC01
    SalesManager --- UC02
    SalesManager --- UC04

    %% Залежності між прецедентами
    UC01 -.->|«include»| UC05
    UC06 -.->|«extend»| UC01

    %% Стилізація меж та вузлів
    style Actors fill:transparent,stroke:none
    style OpenCRM fill:#f8fafc,stroke:#475569,stroke-width:2px,stroke-dasharray: 6 4
    
    %% Стилізація акторів
    style Admin fill:#ede9fe,stroke:#6d28d9,stroke-width:2px,color:#1e1b4b
    style SalesManager fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b

    %% Стилізація прецедентів
    style UC01 fill:#ffffff,stroke:#2563eb,stroke-width:2px,color:#0f172a
    style UC02 fill:#ffffff,stroke:#2563eb,stroke-width:2px,color:#0f172a
    style UC03 fill:#ffffff,stroke:#6d28d9,stroke-width:2px,color:#0f172a
    style UC04 fill:#ffffff,stroke:#2563eb,stroke-width:2px,color:#0f172a
    style UC05 fill:#fffbeb,stroke:#d97706,stroke-width:2px,color:#78350f
    style UC06 fill:#fdf2f8,stroke:#db2777,stroke-width:2px,color:#831843

    %% Стилізація звʼязків
    linkStyle 0 stroke:#6d28d9,stroke-width:2px
    linkStyle 1 stroke:#6d28d9,stroke-width:1.5px
    linkStyle 2 stroke:#4338ca,stroke-width:1.5px
    linkStyle 3 stroke:#4338ca,stroke-width:1.5px
    linkStyle 4 stroke:#4338ca,stroke-width:1.5px
    linkStyle 5 stroke:#d97706,stroke-width:2px,stroke-dasharray: 4 4
    linkStyle 6 stroke:#db2777,stroke-width:2px,stroke-dasharray: 4 4
